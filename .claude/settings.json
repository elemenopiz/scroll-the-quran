{
  "permissions": {
    "allow": [
      "Bash(xcodebuild:*)", "Bash(xcrun:*)", "Bash(xcodegen:*)", "Bash(swift:*)", "Bash(xcbeautify:*)",
      "Bash(magick:*)", "Bash(compare:*)", "Bash(swiftformat:*)", "Bash(swiftlint:*)", "Bash(jq:*)", "Bash(make:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(git worktree:*)", "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git merge:*)", "Bash(git branch:*)",
      "Bash(node Tools/content-gen/*)", "Bash(Tools/verify.sh:*)", "Bash(Tools/snapshot/*)",
      "Read(**)",
      "Edit(App/**)", "Edit(Packages/**)", "Edit(Widget/**)", "Edit(UITests/**)", "Edit(Content/**)", "Edit(Tools/**)",
      "Edit(project.yml)", "Edit(Config/**)", "Edit(CLAUDE.md)", "Edit(Reference/manifest.json)", "Edit(docs/**)",
      "Write(App/**)", "Write(Packages/**)", "Write(Widget/**)", "Write(UITests/**)", "Write(Content/**)", "Write(Tools/**)",
      "Write(Config/**)", "Write(docs/**)"
    ],
    "deny": [
      "Edit(**/*.pbxproj)", "Write(**/*.pbxproj)", "Edit(**/*.xcodeproj/**)", "Write(**/*.xcodeproj/**)",
      "Edit(Tools/content-gen/work/**)", "Edit(.claude/settings.json)",
      "Bash(git push --force:*)", "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-paths.sh" } ] },
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-swift.sh" } ] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-arabic.sh" } ] }
    ]
  }
}

// Copy to Config/Local.xcconfig (gitignored) and fill in your Apple Developer Team ID.
// Base.xcconfig picks it up automatically via `#include? "Local.xcconfig"`.
// Not required for iOS Simulator builds.

DEVELOPMENT_TEAM = ABCDE12345

// RevenueCat public SDK key for this app (appl_…), read into Info.plist as RC_API_KEY once
// the SDK is added (see docs/infra/revenuecat.md). Leave empty to keep StoreKit 2 direct.
RC_API_KEY =

// Release / archive build settings. Base.xcconfig holds everything shared with Debug.
//
// These are the settings `Tools/release/archive.sh` ships with. Bitcode is not a thing
// any more (Xcode 14 dropped it), so there is nothing to turn off; what matters here is
// full optimisation, a dSYM to symbolicate crash reports with, and a stripped binary.

#include "Base.xcconfig"

// Optimisation ---------------------------------------------------------------
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
GCC_OPTIMIZATION_LEVEL = s
ONLY_ACTIVE_ARCH = NO
ENABLE_TESTABILITY = NO
ENABLE_NS_ASSERTIONS = NO
MTL_ENABLE_DEBUG_INFO = NO
VALIDATE_PRODUCT = YES

// Symbols --------------------------------------------------------------------
// dwarf-with-dsym so the archive carries dSYMs for App Store Connect / xcsym.
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
COPY_PHASE_STRIP = NO
STRIP_INSTALLED_PRODUCT = YES
STRIP_SWIFT_SYMBOLS = YES
STRIP_STYLE = all

// Versioning -----------------------------------------------------------------
// Overridden per target in project.yml; repeated here so an `xcodebuild -showBuildSettings
// -configuration Release` on any target shows the shipping numbers.
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

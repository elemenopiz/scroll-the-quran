# Supabase — copy to supabase/.env and fill in. supabase/.env is gitignored.
#
# These are the values the *app* would need the day sync is switched on. They are not
# secrets in the usual sense: the anon key is a public, RLS-scoped JWT and is designed to
# ship inside a client. It still does not belong in git, because rotating a key that is
# committed means rewriting history.
#
# Dashboard -> Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=

# Server-side only. NEVER put this in the app, in web/, or anywhere a client can read it:
# it bypasses every RLS policy in 0001_init.sql.
SUPABASE_SERVICE_ROLE_KEY=

# Sign in with Apple, for `supabase start` / the local auth emulator only. The hosted
# project takes these in the dashboard instead (Authentication -> Sign In / Providers).
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

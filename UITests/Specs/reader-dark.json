      { "name": "reader.toolbar.like", "query": "identifier", "frame": { "x": 50.0, "y": 66.0, "width": 36.0, "height": 36.0 } },
      { "name": "reader.translationPill", "query": "identifier", "frame": { "x": 98.4, "y": 63.4, "width": 62.2, "height": 42.9 }, "tolerance": 8 },
      { "name": "reader.bookmark", "query": "identifier", "frame": { "x": 213.8, "y": 63.4, "width": 43.0, "height": 42.9 } },
      { "name": "reader.surahPill", "query": "identifier", "frame": { "x": 262.7, "y": 63.4, "width": 120.6, "height": 42.9 }, "tolerance": 10 },
